@using Demo.Core.Models
@model List<Course>

@if (Model?.Any() == true)
{
    <section class="course-wrap pt-100 pb-70">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title style1 text-center mb-40">
                        <span>Top Các Khóa học</span>
                        <h2>Top Các Khóa Học Online Của Chúng Tôi</h2>
                    </div>
                </div>
            </div>
            <div class="row justify-content-md-center">
                @foreach (var item in Model)
                {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="course-card style1">
                        <div class="course-img">
                            <a href="course-details.html"><img src="@item.Thumb" alt="Image"></a>
                        </div>
                        <div class="course-info">
                            <h3>
                                <a href="course-details.html">
                                    @item.Title
                                </a>
                            </h3>
                            <div class="course-rating">
                                <ul>
                                    <li> <i class="ri-star-fill"></i></li>
                                    <li> <i class="ri-star-fill"></i></li>
                                    <li> <i class="ri-star-fill"></i></li>
                                    <li> <i class="ri-star-fill"></i></li>
                                    <li> <i class="ri-star-line"></i> </li>
                                </ul>
                                <span>7 Reviews</span>
                            </div>
                            <p>@item.Description</p>
                        </div>
                        <div class="course-metainfo">
                            <div class="course-metainfo-left">
                                <ul>
                                    <li>
                                        <p><i class="ri-user-line"></i>12</p>
                                    </li>
                                    <li>
                                        <p><i class="ri-discuss-line"></i><a href="course-details.html">11</a></p>
                                    </li>
                                </ul>
                            </div>
                            <div class="course-metainfo-right">
                                <div class="price-tag">
                                    <p><span class="discount">@item.FakePrice</span><span>@item.Price</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </section>
}